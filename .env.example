DATABASE_URL=postgres://studio:studio@localhost:5432/studio

# S3-compatible storage. For local dev with the docker-compose MinIO:
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=narration-studio
S3_ACCESS_KEY_ID=studio
S3_SECRET_ACCESS_KEY=studio123

AUTH_SECRET=replace-with-openssl-rand-base64-32

EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=apikey
EMAIL_SERVER_PASSWORD=replace-me
EMAIL_FROM="Narration Studio <no-reply@example.com>"
